+  /**
+   * Custom build: ask the cloud OCR gateway (IMMICH_CLOUD_OCR_URL) to read the original photo first. The gateway
+   * keeps the monthly free quota and returns the result in the same shape, or declines. On decline, timeout or any
+   * error this returns undefined and the local machine learning OCR reads the preview instead.
+   */
+  private async readWithCloudOcr(id: string): Promise<OCR | undefined> {
+    const url = process.env.IMMICH_CLOUD_OCR_URL;
+    const token = process.env.IMMICH_CLOUD_OCR_TOKEN;
+    if (!url || !token) {
+      return undefined;
+    }
+
+    try {
+      const response = await fetch(`${url.replace(/\/$/, '')}/v1/immich/ocr`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify({ assetId: id }),
+        signal: AbortSignal.timeout(Number(process.env.IMMICH_CLOUD_OCR_TIMEOUT_MS || 180_000)),
+      });
+      if (!response.ok) {
+        this.logger.warn(`Cloud OCR gateway returned HTTP ${response.status} for ${id}; using local OCR`);
+        return undefined;
+      }
+      const body = (await response.json()) as { status?: string; reason?: string; ocr?: OCR };
+      if (body.status === 'cloud' && isOcrResult(body.ocr)) {
+        return body.ocr;
+      }
+      this.logger.debug(`Cloud OCR declined for ${id}: ${body.reason ?? body.status}`);
+    } catch (error) {
+      this.logger.warn(`Cloud OCR gateway failed for ${id}; using local OCR: ${error}`);
+    }
+    return undefined;
+  }
+
