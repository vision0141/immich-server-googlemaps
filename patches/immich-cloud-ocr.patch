+  /**
+   * Custom build: ask the cloud OCR gateway (IMMICH_CLOUD_OCR_URL) to read the original photo first. The gateway
+   * keeps the monthly free quota and answers with the result in the same shape (cloud), keep (no text worth reading:
+   * leave the stored OCR as it is) or local (the local machine learning OCR reads the preview). A timeout, an error or a
+   * broken answer is unavailable: the job fails without the local OCR. Without the gateway settings the local OCR reads.
+   */
+  private async askCloudOcr(id: string): Promise<CloudOcrAnswer> {
+    const url = process.env.IMMICH_CLOUD_OCR_URL;
+    const token = process.env.IMMICH_CLOUD_OCR_TOKEN;
+    if (!url || !token) {
+      return { status: 'local' };
+    }
+
+    try {
+      const response = await fetch(`${url.replace(/\/$/, '')}/v1/immich/ocr`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify({ assetId: id }),
+        signal: AbortSignal.timeout(Number(process.env.IMMICH_CLOUD_OCR_TIMEOUT_MS || 180_000)),
+      });
+      if (!response.ok) {
+        this.logger.warn(`Cloud OCR gateway returned HTTP ${response.status} for ${id}; retrying later`);
+        return { status: 'unavailable' };
+      }
+      const body = (await response.json()) as { status?: string; reason?: string; ocr?: OCR };
+      if (body.status === 'cloud' && isOcrResult(body.ocr)) {
+        return { status: 'cloud', ocr: body.ocr };
+      }
+      if (body.status === 'keep' || body.status === 'local') {
+        this.logger.debug(`Cloud OCR declined for ${id} (${body.status}): ${body.reason}`);
+        return { status: body.status };
+      }
+      this.logger.warn(`Cloud OCR gateway returned an unexpected answer for ${id}; retrying later`);
+    } catch (error) {
+      this.logger.warn(`Cloud OCR gateway failed for ${id}; retrying later: ${error}`);
+    }
+    return { status: 'unavailable' };
+  }
+
