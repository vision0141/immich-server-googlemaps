 }
+
+const isOcrResult = (value: unknown): value is OCR => {
+  if (!value || typeof value !== 'object') {
+    return false;
+  }
+  const { text, box, boxScore, textScore } = value as Partial<OCR>;
+  return (
+    Array.isArray(text) &&
+    text.every((item) => typeof item === 'string') &&
+    Array.isArray(box) &&
+    box.length === text.length * 8 &&
+    box.every((item) => typeof item === 'number' && Number.isFinite(item)) &&
+    Array.isArray(boxScore) &&
+    boxScore.length === text.length &&
+    Array.isArray(textScore) &&
+    textScore.length === text.length
+  );
+};
