+    await this.sharedLinkAssetRepository.copySharedLinks({ sourceAssetId: previous.id, targetAssetId: edited.id });
+    await this.tagRepository.upsertAssetIds(previous.tags.map(({ tagId }) => ({ assetId: edited.id, tagId })));
+    await this.assetRepository.update({
+      id: edited.id,
+      isFavorite: previous.isFavorite,
+      visibility: previous.visibility,
+    });
+    await this.copyEditedUploadSidecar(previous, edited);
+
+    await this.assetRepository.updateAll([previous.id], { deletedAt: new Date(), status: AssetStatus.Trashed });
+    await this.eventRepository.emit('AssetTrashAll', { assetIds: [previous.id], userId: auth.user.id });
+
+    this.logger.log(`Moved previous version ${previous.id} of edited upload ${edited.id} to trash instead of stacking`);
+    return true;
+  }
+
+  private isEditedUploadPair(auth: AuthDto, edited: EditedUploadAsset, previous: EditedUploadAsset) {
+    return (
+      edited.ownerId === auth.user.id &&
+      previous.ownerId === auth.user.id &&
+      !edited.libraryId &&
+      !previous.libraryId &&
+      edited.type === previous.type &&
+      !edited.stackId &&
+      !previous.stackId &&
+      edited.visibility === AssetVisibility.Timeline &&
+      (previous.visibility === AssetVisibility.Timeline || previous.visibility === AssetVisibility.Archive) &&
+      edited.fileCreatedAt.getTime() === previous.fileCreatedAt.getTime() &&
+      getEditedUploadBaseName(edited.originalFileName) === getEditedUploadBaseName(previous.originalFileName) &&
+      edited.createdAt > previous.createdAt &&
+      Date.now() - edited.createdAt.getTime() <= EDITED_UPLOAD_MAX_AGE_MS
+    );
+  }
+
+  /** 前の版のsidecar(Immichで直した説明文、日時、場所、評価、タグ)を新へ写し、新のメタデータを読み直させる */
+  private async copyEditedUploadSidecar(previous: EditedUploadAsset, edited: EditedUploadAsset) {
+    const { sidecarFile: previousSidecar } = getAssetFiles(previous.files);
+    if (!previousSidecar?.path) {
+      return;
+    }
+
+    const { sidecarFile: editedSidecar } = getAssetFiles(edited.files);
+    if (editedSidecar?.path) {
+      await this.storageRepository.unlink(editedSidecar.path);
+    }
+
+    const path = `${edited.originalPath}.xmp`;
+    await this.storageRepository.copyFile(previousSidecar.path, path);
+    await this.assetRepository.upsertFile({ assetId: edited.id, path, type: AssetFileType.Sidecar });
+    await this.jobRepository.queue({ name: JobName.AssetExtractMetadata, data: { id: edited.id } });
+  }
+
   private findOrFail(id: string) {
     return findOrFail(() => this.stackRepository.getById(id), 'Asset stack');
   }
