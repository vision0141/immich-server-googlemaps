index 0000000..771ee5a
--- /dev/null
+++ b/web/src/lib/utils/google-basemap.ts
@@ -0,0 +1,106 @@
+// Googleの地図(Maps JavaScript API、Dynamic Maps)を地図の背景に敷く。地図を1枚作るごとに課金の1回になるため、
+// 作る前に LOAD_URL を呼ぶ(CaddyがImmichのログインを確かめてPrism Chatへ中継し、Prism Chatと合わせた月の回数が上限の前ならキーを返す)。
+// 作った地図はページの中で使い回す。上限、キーの拒否、読込みの失敗では使わず、呼出し側はMapLibreのスタイル(MapTiler)に戻す
+const LOAD_URL = '/prism-maps/google-load';
+
+export type GoogleBasemap = {
+  div: HTMLDivElement;
+  map: { moveCamera(options: { center: { lat: number; lng: number }; zoom: number }): void };
+};
+type GoogleMaps = { Map: new (element: HTMLElement, options: object) => GoogleBasemap['map'] };
+
+let down = false;
+let api: Promise<GoogleMaps> | undefined;
+const free: GoogleBasemap[] = [];
+const failWatchers = new Set<() => void>();
+
+export const isGoogleBasemapDown = () => down;
+
+// キーが拒否された時(gm_authFailure)に、表示中の地図がMapTilerへ戻すために呼ばれる
+export const onGoogleBasemapFail = (watcher: () => void) => {
+  failWatchers.add(watcher);
+  return () => failWatchers.delete(watcher);
+};
+
+const fail = () => {
+  down = true;
+  for (const watcher of failWatchers) {
+    watcher();
+  }
+};
+
+const loadApi = (key: string) =>
+  (api ??= new Promise<GoogleMaps>((resolve, reject) => {
+    const global = globalThis as unknown as Record<string, unknown>;
+    global.gm_authFailure = fail;
+    global.__immichGoogleMaps = () => {
+      const maps = (global.google as { maps: { importLibrary(name: string): Promise<GoogleMaps> } }).maps;
+      maps.importLibrary('maps').then(resolve).catch(reject);
+    };
+    const query = new URLSearchParams({
+      key,
+      v: 'weekly',
+      language: 'ja',
+      region: 'JP',
+      loading: 'async',
+      callback: '__immichGoogleMaps',
+    });
+    const script = document.createElement('script');
+    script.src = `https://maps.googleapis.com/maps/api/js?${query}`;
+    script.async = true;
+    script.addEventListener('error', () => reject(new Error('Maps JavaScript APIを読めません')));
+    document.head.append(script);
+  }));
+
+// parentの一番下(MapLibreの描画より下)に地図を置いて返す。使えない時はundefined
+export const acquireGoogleBasemap = async (parent: HTMLElement): Promise<GoogleBasemap | undefined> => {
+  if (down) {
+    return;
+  }
+  const reused = free.pop();
+  if (reused) {
+    parent.prepend(reused.div);
+    return reused;
+  }
+  try {
+    // 返らない時に地図が空のままにならないよう、5秒で諦めてMapTilerにする
+    const response = await fetch(LOAD_URL, { method: 'POST', signal: AbortSignal.timeout(5000) });
+    const body = response.ok ? ((await response.json()) as { ok?: boolean; key?: string }) : {};
+    if (!body.ok || !body.key) {
+      down = true; // 今月の上限か、中継の無いドメイン
+      return;
+    }
+    const { Map } = await loadApi(body.key);
+    if (down) {
+      return;
+    }
+    // Googleは地図の要素の位置を書き換え、中の部品に大きなz-indexを付けるため、外側の要素で位置と重なりを決める
+    const div = document.createElement('div');
+    div.className = 'immich-google-basemap';
+    const inner = document.createElement('div');
+    inner.style.cssText = 'width: 100%; height: 100%';
+    div.append(inner);
+    parent.prepend(div);
+    const map = new Map(inner, {
+      center: { lat: 0, lng: 0 },
+      zoom: 1,
+      mapTypeId: 'hybrid',
+      tilt: 0,
+      disableDefaultUI: true,
+      gestureHandling: 'none',
+      keyboardShortcuts: false,
+      clickableIcons: false,
+      isFractionalZoomEnabled: true,
+    });
+    return { div, map };
+  } catch {
+    fail();
+  }
+};
+
+export const releaseGoogleBasemap = (basemap: GoogleBasemap) => {
+  basemap.div.remove();
+  if (!down) {
+    free.push(basemap);
+  }
+};
